#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later

START=25
STOP=85
USE_PROCD=1

APPLY_BIN=/usr/libexec/rtl9617c-qos-apply

start_service() {
	[ -x "$APPLY_BIN" ] || chmod 0755 "$APPLY_BIN" 2>/dev/null
	"$APPLY_BIN" apply
}

stop_service() {
	[ -x "$APPLY_BIN" ] || chmod 0755 "$APPLY_BIN" 2>/dev/null
	"$APPLY_BIN" stop
}

reload_service() {
	[ -x "$APPLY_BIN" ] || chmod 0755 "$APPLY_BIN" 2>/dev/null
	"$APPLY_BIN" apply
}

service_triggers() {
	procd_add_reload_trigger rtl9617c_qos
}
