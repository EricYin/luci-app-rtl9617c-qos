msgstr "%d 个包（端口）"

msgid "%d queues active · ECN %s"
msgstr "%d 队列生效 · ECN %s"

msgid "%d queues bound (globally off)"
msgstr "%d 队列已绑但全局未启"

msgid "%d rules"
msgstr "%d 条规则"

msgid "%d rules · Custom"
msgstr "%d 条规则 · 自定义"

msgid "%d tracked IPs"
msgstr "已捕获 %d 个 IP"

