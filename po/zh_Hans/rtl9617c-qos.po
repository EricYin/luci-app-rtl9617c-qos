msgid "#"
msgstr "编号"

msgid "# Categories: mobile_game / pc_game / voice_meeting / remote_desk / education / im_chat / video_live / finance / download_bulk / custom"
msgstr "# 常用分类：mobile_game / pc_game / voice_meeting / remote_desk / education / im_chat / video_live / finance / download_bulk / custom"

msgid "# Format: Category | Name | Domains (;/space) | TCP | UDP"
msgstr "# 格式：分类 | 名称 | 域名(;或空格) | TCP | UDP"

msgid "# One domain per line (supports DOMAIN-SUFFIX, *.wildcard, +.prefix)"
msgstr "# 每行一个域名（支持 DOMAIN-SUFFIX / *.通配符 / +.前缀）"

