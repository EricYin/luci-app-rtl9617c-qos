msgid "#"
msgstr "编号"

msgid "# Common categories: mobile_game / pc_game / voice_meeting / remote_desk / education / im_chat / video_live / finance / download_bulk / custom"
msgstr "# 常用分类：mobile_game / pc_game / voice_meeting / remote_desk / education / im_chat / video_live / finance / download_bulk / custom"

msgid "# Format: CategoryID | App Name | Domain List (semicolon or space separated) | TCP Ports | UDP Ports"
msgstr "# 格式：分类ID | 应用名称 | 域名列表(分号或空格分隔) | TCP端口 | UDP端口"

msgid "# One domain per line; also supports Clash DOMAIN-SUFFIX / *.wildcard / +.prefix"
msgstr "# 每行一个域名，也支持 Clash DOMAIN-SUFFIX / *.通配符 / +.前缀"

msgid "%d / %d connected"
msgstr "%d / %d 个已连接"

msgid "%d / %d devices"
msgstr "%d / %d 台"

msgid "%d / %d enabled"
msgstr "已启用 %d / %d 项"

msgid "%d / %d groups used"
msgstr "%d / %d 组已用"

msgid "%d / %d ports enabled"
msgstr "%d / %d 口已开启"

msgid "%d / %d used"
msgstr "%d / %d 个"

msgid "%d active flows (%d%%)"
msgstr "%d 条活跃流（占比 %d%%）"

msgid "%d active hardware entries"
msgstr "共 %d 条活跃硬件项"

msgid "%d app signatures loaded; once enabled, auto-detects via dnsmasq nftset + dedicated ports."
msgstr "已加载 %d 款应用特征，开启后通过 dnsmasq nftset + 专用端口自动识别。"

msgid "%d apps total · %d domains"
msgstr "共 %d 款应用 · %d 条域名"

